# Copy this file to .env and fill in. NEVER commit .env.

# mock = no key needed (default). anthropic or openai = real model.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Use a long random string in any shared/deployed environment.
JWT_SECRET=dev-only-change-me-before-deploying-0000
JWT_EXPIRE_MINUTES=30

# Comma-separated. Vite dev server runs on 5173.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
